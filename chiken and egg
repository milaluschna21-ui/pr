public class chiken {
    static String last = ""; // Здесь храним последнее слово
    public static synchronized void chicken() { // Метод для курицы с синхронизацией
        System.out.println("Курица"); // Выводим слово "Курица"
        last = "Курица"; // Запоминаем последнее слово
    }
    public static synchronized void egg() { // Метод для яйца с синхронизацией
        System.out.println("Яйцо"); // Выводим слово "Яйцо"
        last = "Яйцо"; // Запоминаем последнее слово
    }
    public static void main(String[] args) throws InterruptedException { // Главный метод программы
        Thread chicken = new Thread(() -> { // Создаём поток "Курица"
            for (int i = 0; i < 5; i++) { // Повторяем 5 раз
                chiken.chicken(); // Вызываем метод курицы
            }
        });
        Thread egg = new Thread(() -> { // Создаём поток "Яйцо"
            for (int i = 0; i < 5; i++) { // Повторяем 5 раз
                chiken.egg(); // Вызываем метод яйца
            }
        });
        chicken.start(); // Запускаем поток курицы
        egg.start(); // Запускаем поток яйца
        chicken.join(); // Ждём завершения потока курицы
        egg.join(); // Ждём завершения потока яйца
        System.out.println("Спор окончен. Победила " + last); // Выводим последнее слово
    }
}
