/**
 * Демонстрационная программа для работы с билетами в кино и зрителями.
 * <p>
 * Программа показывает применение классов, наследование,
 * а также объединение возможностей билета и зрителя в классе {@link TicketViewer}.
 * </p>
 *
 */
public class Main {

    /**
     * Конструктор главного класса.
     * Создание экземпляров класса Main не требуется.
     */
    public Main() {
    }

    /**
     * Запускает программу, создаёт примеры билетов и зрителей
     * и демонстрирует покупку билета.
     *
     * @param args аргументы командной строки
     */
    public static void main(String[] args) {
        Ticket T1 = new CinemaTicket("Дюна 2", 450, 5.0);
        Ticket T2 = new CinemaTicket2("Оппенгеймер", 600, 4.8);
        Ticket T3 = new CinemaTicket3("Барби", 350, 4.2);

        Viewer V1 = new Viewer1("Ivan", "PassIvan1");
        Viewer V2 = new Viewer2("Anna", "PassAnna2");
        Viewer V3 = new Viewer3("Oleg", "PassOleg3");

        TicketViewer TV = new TicketViewer("Masha", "PassMasha", "Гарри Поттер", 500, 4.9);

        TV.buyTicket();
    }
}

/**
 * Базовый класс билета в кино.
 * Хранит название фильма, стоимость билета и рейтинг фильма.
 */
class Ticket {
    /** Название фильма. */
    String movieName;

    /** Стоимость билета. */
    int price;

    /** Рейтинг фильма. */
    double rating;

    /**
     * Создаёт билет с указанными характеристиками.
     *
     * @param movieName название фильма
     * @param price стоимость билета
     * @param rating рейтинг фильма
     */
    public Ticket(String movieName, int price, double rating) {
        this.movieName = movieName;
        this.price = price;
        this.rating = rating;
    }

    /**
     * Выводит название фильма в консоль.
     */
    public void showMovie() {
        System.out.println("Фильм: " + movieName);
    }

    /**
     * Выводит цену билета в консоль.
     */
    public void showPrice() {
        System.out.println("Цена билета: " + price);
    }

    /**
     * Выводит рейтинг фильма в консоль.
     */
    public void showRating() {
        System.out.println("Рейтинг: " + rating);
    }
}

/**
 * Первый вариант билета, наследующий базовый {@link Ticket}.
 */
class CinemaTicket extends Ticket {
    /**
     * Создаёт билет с указанными характеристиками.
     *
     * @param movieName название фильма
     * @param price стоимость билета
     * @param rating рейтинг фильма
     */
    public CinemaTicket(String movieName, int price, double rating) {
        super(movieName, price, rating);
    }
}

