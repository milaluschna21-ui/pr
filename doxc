/**
 * Класс, объединяющий данные зрителя и характеристики билета.
 * Наследует класс {@link Viewer} и содержит внутри себя билет.
 */
class TicketViewer extends Viewer {
    /** Название фильма. */
    String movieName;

    /** Стоимость билета. */
    int price;

    /** Рейтинг фильма. */
    double rating;

    /**
     * Создаёт объект, содержащий данные зрителя и билета.
     *
     * @param login логин зрителя
     * @param password пароль зрителя
     * @param movieName название фильма
     * @param price стоимость билета
     * @param rating рейтинг фильма
     */
    public TicketViewer(String login, String password, String movieName, int price, double rating) {
        super(login, password);
        this.movieName = movieName;
        this.price = price;
        this.rating = rating;
    }

    /**
     * Выводит название фильма в консоль.
     */
    public void showMovie() {
        System.out.println("Фильм: " + movieName);
    }

    /**
     * Выводит стоимость билета в консоль.
     */
    public void showPrice() {
        System.out.println("Стоимость: " + price);
    }

    /**
     * Выводит рейтинг фильма в консоль.
     */
    public void showRating() {
        System.out.println("Рейтинг: " + rating);
    }

    /**
     * Выводит сообщение о покупке билета зрителем.
     */
    public void buyTicket() {
        System.out.println("Зритель " + getLogin() + " купил билет на фильм '" + movieName + "' за " + price + " руб.");
    }
}
