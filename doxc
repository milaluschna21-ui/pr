/**
 * Базовый класс зрителя (покупателя).
 */
class Viewer {
    /** Логин зрителя. */
    private String login;

    /** Пароль зрителя. */
    private String password;

    /**
     * Создаёт зрителя с заданными логином и паролем.
     *
     * @param login логин зрителя
     * @param password пароль зрителя
     */
    public Viewer(String login, String password) {
        this.login = login;
        this.password = password;
    }

    /**
     * Выводит логин зрителя в консоль.
     */
    public void printLogin() {
        System.out.println("Логин зрителя: " + login);
    }

    /**
     * Выводит пароль зрителя в консоль.
     */
    public void printPassword() {
        System.out.println("Пароль: " + password);
    }

    /**
     * Возвращает логин зрителя.
     *
     * @return строка, содержащая логин зрителя
     */
    public String getLogin() {
        return this.login;
    }
}

/**
 * Класс первого зрителя, наследующий базовый {@link Viewer}.
 */
class Viewer1 extends Viewer {
    /**
     * Создаёт зрителя с заданными логином и паролем.
     *
     * @param login логин зрителя
     * @param password пароль зрителя
     */
    public Viewer1(String login, String password) {
        super(login, password);
    }
}

