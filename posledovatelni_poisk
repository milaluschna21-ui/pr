import java.io.File;
import java.io.FileNotFoundException;
import java.util.Scanner;

public class poisk {
    public static void main(String[] args) throws FileNotFoundException {

        final int KOLICHESTVO = 1000;
        final int DELITEL = 14;

        Scanner scanner = new Scanner(
                new File("C:\\Users\\Пользователь\\Downloads\\Посл поиск.txt")
        );

        int luchsheeProizvedenie = -1;
        int samoeBolshoe = -1;
        int vtoroeBolshoe = -1;

        for (int nomer = 0; nomer < KOLICHESTVO; nomer++) {

            int chislo = scanner.nextInt();

            if (chislo % DELITEL == 0) {
                if (vtoroeBolshoe != -1) {
                    int proizvedenie = chislo * vtoroeBolshoe;

                    if (proizvedenie > luchsheeProizvedenie) {
                        luchsheeProizvedenie = proizvedenie;
                    }
                }
            }

            if (chislo % 7 == 0) {
                if (samoeBolshoe != -1) {
                    int proizvedenie = chislo * samoeBolshoe;

                    if (proizvedenie % DELITEL == 0 &&
                            proizvedenie > luchsheeProizvedenie) {
                        luchsheeProizvedenie = proizvedenie;
                    }
                }
            }

            if (chislo > samoeBolshoe) {
                vtoroeBolshoe = samoeBolshoe;
                samoeBolshoe = chislo;
            } else if (chislo > vtoroeBolshoe) {
                vtoroeBolshoe = chislo;
            }
        }

        scanner.close();

        System.out.println("Результат: " + luchsheeProizvedenie);
    }
}
