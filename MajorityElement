public class mazor {
    public static void main(String[] args) {
        // массив чисел
        int[] nums = {2, 1, 2, 3, 4, 2, 1, 2, 2};

        // кандидат на мажоритарное число
        int candidate = 0;

        // счётчик жизней кандидата
        int count = 0;

        // идём по массиву по одному числу
        for (int num : nums) {
            // если счётчик 0 — кандидата нет, берём текущее число
            if (count == 0) {
                candidate = num; // новый кандидат
                count = 1;       // даём 1 жизнь
            }
            // если текущее число совпало с кандидатом
            else if (num == candidate) {
                count++; // добавляем жизнь
            }
            // если текущее число другое
            else {
                count--; // отнимаем жизнь
            }
        }

        // выводим кандидата — это мажоритарное число
        System.out.println(candidate);
    }
}
