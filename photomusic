import javazoom.jl.decoder.JavaLayerException;
import javazoom.jl.player.Player;

import java.io.*;
import java.net.URL;
import java.nio.file.Files;
import java.nio.file.Path;

public class photomusic {
    private static final String INPUT_FILE = "input.txt";

    public static void main(String[] args) {
        String imageUrl  = "https://sun9-51.vkuserphoto.ru/s/v1/ig2/Vn7FZTFdMwVDwv84pNJ6aFMDMhgTxapTNx97BlcYNPnBR7cJTtkm46qDnK7GsOiETjQvlw-4-BWhpf-ayJnO1bdO.jpg?quality=95&as=32x71,48x107,72x160,108x240,160x356,240x533,360x800,480x1067,540x1200,640x1422,720x1600,1080x2400&from=bu&cs=1080x0";
        String imagePath = "images/my_picture.jpg";

        String musicUrl = "https://www.soundhelix.com/examples/mp3/SoundHelix-Song-1.mp3";
        String musicPath = "music/my_song.mp3";

        try (FileWriter fw = new FileWriter(INPUT_FILE)) {
            fw.write(imageUrl + " " + imagePath + "\n");
            fw.write(musicUrl + " " + musicPath + "\n");
        } catch (IOException e) {
            System.err.println("Ошибка записи input.txt: " + e.getMessage());
            return;
        }

        try (BufferedReader br = new BufferedReader(new FileReader(INPUT_FILE))) {
            String[] imageParts = br.readLine().split("\\s+");
            String[] musicParts = br.readLine().split("\\s+");

            Thread imageThread = new Thread(() -> {
                try {
                    download(imageParts[0], imageParts[1]);
                    System.out.println("[Картинка] Готово: " + imageParts[1]);
                } catch (IOException e) {
                    System.err.println("[Картинка] Ошибка: " + e.getMessage());
                }
            });

            Thread musicThread = new Thread(() -> {
                try {
                    download(musicParts[0], musicParts[1]);
                    System.out.println("[Музыка] Готово: " + musicParts[1]);
                    playMusic(musicParts[1]); // играем после скачивания
                } catch (IOException | JavaLayerException e) {
                    System.err.println("[Музыка] Ошибка: " + e.getMessage());
                }
            });

            imageThread.start();
            musicThread.start();

            imageThread.join();
            musicThread.join();
            System.out.println("Все файлы скачаны.");
        } catch (IOException | InterruptedException e) {
            System.err.println("Ошибка работы с input.txt: " + e.getMessage());
        }
    }

    private static void download(String urlStr, String fileName) throws IOException {
        Files.createDirectories(Path.of(fileName).getParent());
        try (InputStream in = new URL(urlStr).openStream();
             OutputStream out = Files.newOutputStream(Path.of(fileName))) {
            byte[] buffer = new byte[8192];
            int bytesRead;
            while ((bytesRead = in.read(buffer)) != -1) {
                out.write(buffer, 0, bytesRead);
            }
        }
    }

    private static void playMusic(String path) throws IOException, JavaLayerException {
        try (FileInputStream fis = new FileInputStream(path)) {
            Player player = new Player(fis);
            player.play();
        }
    }
}
